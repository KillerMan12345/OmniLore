# =============================================================================
# OmniLore v0.3.0-alpha (internal generation: v2.3) — 环境变量模板
# 用法：cp .env.example .env
#
# ⚠️ 本文件**不会自动被读取**：本项目只读进程环境变量，仓库里没有任何 dotenv 依赖。
#    * 容器模式：`docker compose` 会读取同目录的 `.env` 并把下面的变量转发进容器
#      （`docker-compose.yml` 里已逐项列出）—— 这一条是**真的生效**的；
#    * 本地模式：`.env` 只是一张清单，请自己载入进程环境：
#        bash:       set -a && source .env && set +a
#        PowerShell: $env:OMNILORE_PROTECTED_FRONTMATTER = "doc_id"
#      或者直接 `export OMNILORE_...=...`。
#    * 每次 `omnilore bootstrap` 都会在 **stderr** 回显当前实际生效的受保护字段与
#      冲突目录，变量名拼错也会被点名 —— 「配了却没生效」不会静默。
#
# 【必填 / 可选 图例】
#   [必填-容器] 使用 docker compose 时必须设置
#   [必填-本地] 使用本地内存引擎时必须设置
#   [可选]     可以完全不填；不填时的行为已在注释中说明
#
# 零 API Key 也能跑：所有 [可选] 项留空时，检索会自动降级为 BM25 / 关键词模式，
# 首次检索不会因为缺 key 而失败（见 README「零密钥降级」）。
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL 连接设置   [必填-容器]
# -----------------------------------------------------------------------------
POSTGRES_USER=omnilore_migrator
POSTGRES_PASSWORD=replace_with_strong_migrator_password
GATEWAY_DB_PASSWORD=replace_with_strong_gateway_password
POSTGRES_DB=omnilore

# 完整连接串。本地模式（走内置内存引擎 RLSDatabaseEngine）不需要真实的 PG，
# 可以保留默认值；容器模式必须指向可访问的数据库。   [必填-容器]
DATABASE_URL=postgresql://omnilore_gateway:replace_with_strong_gateway_password@localhost:5432/omnilore

# -----------------------------------------------------------------------------
# 存储路径   [必填-本地]
# -----------------------------------------------------------------------------
# 本地模式的知识库根目录（CAS 资产、Vault 知识页、引导状态都在这里）
OMNILORE_DATA_DIR=./OmniLore_Data

# -----------------------------------------------------------------------------
# 首启引导   [可选]
# -----------------------------------------------------------------------------
# 是否在 MCP stdio 服务启动时**自动创建**默认空间与 owner token。
# 注意：这只控制「没有身份时是否新建」，**不影响**已存在的 $OMNILORE_DATA_DIR/ops/bootstrap.json
# —— 该文件存在时其身份总会被加载，既有 token 不受本开关影响。
# 1 = 开启（默认）；0 = 关闭（此时若尚无身份则必须自行运行 `omnilore bootstrap`）
OMNILORE_AUTO_BOOTSTRAP=1
# 显式指定 owner token；留空则由 `omnilore bootstrap` 随机生成并持久化到
# $OMNILORE_DATA_DIR/ops/bootstrap.json
OMNILORE_BOOTSTRAP_TOKEN=

# -----------------------------------------------------------------------------
# Obsidian 笔记主权（R-16）—— 我们往你的笔记里写字段，但主权归你   [可选]
# -----------------------------------------------------------------------------
# OmniLore 会在知识页的 YAML frontmatter 写入 9 个系统字段（doc_id / space_id /
# series_id / version_key / version_label / source_asset_ids / source_task_id /
# content_revision / review_status）。其中 space_id / series_id / version_key /
# version_label 默认**受保护**：在 Obsidian 里改它们会被同步拒绝。
#
# 想自己说了算，就把这里改成你想要的白名单（逗号分隔），例如只保护归属字段：
#   OMNILORE_PROTECTED_FRONTMATTER=doc_id,space_id,series_id
# 或整体关闭保护：
#   OMNILORE_PROTECTED_FRONTMATTER=none
#
# 说明：
#   * `doc_id` 是身份锚点，永远受保护，不参与本配置；
#   * 关掉某字段 = 改它不再被拒绝，同时也不再强制要求它必须存在；
#   * 关掉 `content_revision` 后若把它从 frontmatter 里删掉，该文档就不再做乐观并发
#     检测（不会再生成冲突副本）；字段仍在时仍照常检测；
#   * 字段名写错会**直接报错**，不会被静默当成「关闭保护」。
# 不设置 = 使用默认的全量保护（9 个字段）。
# OMNILORE_PROTECTED_FRONTMATTER=

# 并发冲突时生成的 `.conflict_r*.md` 副本落到哪里。   [可选]
# 必须是 vault 内的相对目录，默认 `.omnilore/conflicts`（点号开头 = **Obsidian 默认忽略**。
# 注意：Windows 资源管理器**仍然可见**，NTFS 不因点号隐藏目录）。禁止绝对路径与 `..`。
# OMNILORE_CONFLICT_DIR=.omnilore/conflicts

# -----------------------------------------------------------------------------
# 模型与向量（R-04b）   【可选 —— 全部留空也能完整跑通】
# -----------------------------------------------------------------------------
# 零 Key 行为：不配任何一项时，检索自动降级为纯 BM25 / 关键词
# （retrieval_mode=keyword_only、degraded_reason 非空），首次检索不会因为缺 key 而失败。
#
# ── 向量来源（可替换，不再绑死阿里云）──────────────────────────────────────────
# dashscope = 阿里云百炼（默认，行为与 v0.3.0 完全一致）
# openai    = 任意 OpenAI 兼容端点：OpenAI / Azure OpenAI / **Ollama** / vLLM /
#             LM Studio / 硅基流动 …… 只要它接受 POST {base_url}/embeddings
# none      = 显式只用 BM25（不配 key、也不尝试向量召回；degraded_reason 会说明这是配置选择）
OMNILORE_EMBEDDING_PROVIDER=dashscope
# 仅对 openai 生效。Ollama 用 http://localhost:11434/v1；LM Studio 用 http://127.0.0.1:1234/v1。
# 留空时默认 https://api.openai.com/v1。
# 本地回环地址（localhost / 127.0.0.1 / host.docker.internal）**不需要** API Key。
OMNILORE_EMBEDDING_BASE_URL=
# openai 的鉴权：优先读本变量，其次 OPENAI_API_KEY；本地端点可以都不设。
OMNILORE_EMBEDDING_API_KEY=
#
# ── 下面 4 项**现在真的被读取**（v0.3.0-alpha 里曾是「预留、改动无效」，R-04b 已兑现）──
# 实际生效值每次 `omnilore bootstrap` 都会回显（含 provider / 模型 / 维度 / 是否降级），
# 变量名拼错也会被点名 —— 不会出现「看起来能配其实没用」。
# 对应的 Python 读取点：omnilore/dashscope_client.py:ModelAdapterConfig.__post_init__
OMNILORE_PRIMARY_MODEL=qwen3.8-flash
OMNILORE_ESCALATED_MODEL=qwen3.8-max
OMNILORE_EMBEDDING_MODEL=text-embedding-v4
# 必须与 provider 实际返回的维度一致。不一致会**响亮报错**（不截断、不补零 ——
# 那会产生错误的相似度）。OpenAI text-embedding-3-small 是 1536，Ollama nomic-embed-text 是 768。
OMNILORE_EMBEDDING_DIM=1024
#
# ── 阿里云百炼（默认 provider 的凭据）────────────────────────────────────────
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
# 说明：chat（答案合成）目前仍走 DashScope 的 OpenAI 兼容端点（未配置 DASHSCOPE_API_KEY 时
# 用本地确定性逻辑）。R-04b 抽象的是**向量**这一层；chat 侧的 provider 化仍是后续工作。

# -----------------------------------------------------------------------------
# n8n 可选集成   [可选]
# -----------------------------------------------------------------------------
# 只有 `docker compose --profile integrations up -d` 时才需要设置。
OMNILORE_WORKER_SCOPED_TOKEN=

# -----------------------------------------------------------------------------
# 遥测   [可选]
# -----------------------------------------------------------------------------
# 遥测（匿名、opt-in）已在决策中被接受，但 v0.3.0-alpha 尚未实现，实现排期 Q2。
# 这里保留开关位并默认关闭；实现后也必须保持「默认关闭」。
OMNILORE_TELEMETRY=0
