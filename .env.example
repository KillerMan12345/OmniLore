# =============================================================================
# OmniLore v0.3.0-alpha (internal generation: v2.3) — 环境变量模板
# 用法：cp .env.example .env
#
# 【必填 / 可选 图例】
#   [必填-容器] 使用 docker compose 时必须设置
#   [必填-本地] 使用本地内存引擎时必须设置
#   [可选]     可以完全不填；不填时的行为已在注释中说明
#
# 零 API Key 也能跑：所有 [可选] 项留空时，检索会自动降级为 BM25 / 关键词模式，
# 首次检索不会因为缺 key 而失败（见 README「零密钥降级」）。
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL 连接设置   [必填-容器]
# -----------------------------------------------------------------------------
POSTGRES_USER=omnilore_migrator
POSTGRES_PASSWORD=replace_with_strong_migrator_password
GATEWAY_DB_PASSWORD=replace_with_strong_gateway_password
POSTGRES_DB=omnilore

# 完整连接串。本地模式（走内置内存引擎 RLSDatabaseEngine）不需要真实的 PG，
# 可以保留默认值；容器模式必须指向可访问的数据库。   [必填-容器]
DATABASE_URL=postgresql://omnilore_gateway:replace_with_strong_gateway_password@localhost:5432/omnilore

# -----------------------------------------------------------------------------
# 存储路径   [必填-本地]
# -----------------------------------------------------------------------------
# 本地模式的知识库根目录（CAS 资产、Vault 知识页、引导状态都在这里）
OMNILORE_DATA_DIR=./OmniLore_Data

# -----------------------------------------------------------------------------
# 首启引导   [可选]
# -----------------------------------------------------------------------------
# 是否在 MCP stdio 服务启动时**自动创建**默认空间与 owner token。
# 注意：这只控制「没有身份时是否新建」，**不影响**已存在的 $OMNILORE_DATA_DIR/ops/bootstrap.json
# —— 该文件存在时其身份总会被加载，既有 token 不受本开关影响。
# 1 = 开启（默认）；0 = 关闭（此时若尚无身份则必须自行运行 `omnilore bootstrap`）
OMNILORE_AUTO_BOOTSTRAP=1
# 显式指定 owner token；留空则由 `omnilore bootstrap` 随机生成并持久化到
# $OMNILORE_DATA_DIR/ops/bootstrap.json
OMNILORE_BOOTSTRAP_TOKEN=

# -----------------------------------------------------------------------------
# 阿里云百炼（DashScope）   【可选 —— 全部留空也能完整跑通】
# -----------------------------------------------------------------------------
# 不配置时不会报错：检索自动降级为纯 BM25 / 关键词（retrieval_mode=keyword_only、
# degraded_reason 非空）。配置后升级为 BM25 + 1024 维向量的混合检索。
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
# ⚠️ 下面 4 项在 v0.3.0-alpha 中**不会被代码读取**：它们是预留位，实际生效的模型名与
# 向量维度来自 `omnilore/dashscope_client.py` 里 `ModelAdapterConfig` 的字段默认值
# （当前即 qwen3.8-flash / qwen3.8-max / text-embedding-v4 / 1024，与此处写法一致）。
# 改动这些变量不会有任何效果 —— 请勿据此认为模型可配。
# 计划随 v0.3.1 的 provider 抽象（R-04b）一并接通，接通前保持「默认关闭、不读不写」。
OMNILORE_PRIMARY_MODEL=qwen3.8-flash
OMNILORE_ESCALATED_MODEL=qwen3.8-max
OMNILORE_EMBEDDING_MODEL=text-embedding-v4
OMNILORE_EMBEDDING_DIM=1024

# -----------------------------------------------------------------------------
# n8n 可选集成   [可选]
# -----------------------------------------------------------------------------
# 只有 `docker compose --profile integrations up -d` 时才需要设置。
OMNILORE_WORKER_SCOPED_TOKEN=

# -----------------------------------------------------------------------------
# 遥测   [可选]
# -----------------------------------------------------------------------------
# 遥测（匿名、opt-in）已在决策中被接受，但 v0.3.0-alpha 尚未实现，实现排期 Q2。
# 这里保留开关位并默认关闭；实现后也必须保持「默认关闭」。
OMNILORE_TELEMETRY=0
