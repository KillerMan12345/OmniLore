{
  "name": "OmniLore 02 - Outbox Crash Recovery & Obsidian Sync Worker",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "node-schedule-recovery",
      "name": "Every 1 Minute Recovery Tick",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OMNILORE_INTERNAL_API_URL || 'http://mcp-gateway:8080' }}/internal/v1/outbox/recover",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-OmniLore-Token",
              "value": "={{ $env.OMNILORE_WORKER_SCOPED_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"space_ids\": [\"sp_personal_alice\", \"sp_family_home\"]}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "node-call-outbox-recover",
      "name": "Execute Outbox Saga Recovery & Obsidian Watcher",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "leftValue": "={{ $json.data.is_consistent }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-check-consistency",
      "name": "Verify DB vs Filesystem Consistency",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        800,
        300
      ]
    }
  ],
  "connections": {
    "Every 1 Minute Recovery Tick": {
      "main": [
        [
          {
            "node": "Execute Outbox Saga Recovery & Obsidian Watcher",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Outbox Saga Recovery & Obsidian Watcher": {
      "main": [
        [
          {
            "node": "Verify DB vs Filesystem Consistency",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "omnilore_version": "2.3.0",
    "security_boundary": "Uses scoped worker token; no BYPASSRLS or superuser credentials."
  }
}